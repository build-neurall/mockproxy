{
  "name": "@neurall.build/mockproxy",
  "version": "0.1.0",
  "description": "Test your AI app without burning API credits - Mock OpenAI, Anthropic, Gemini and any AI service",
  "module": "src/index.ts",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "mockproxy": "./dist/index.js"
  },
  "files": [
    "dist/",
    "pricing.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun --minify",
    "start": "bun run src/index.ts",
    "test": "bun test tests/",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "ai",
    "mock",
    "proxy",
    "openai",
    "anthropic",
    "gemini",
    "testing",
    "caching",
    "offline",
    "developer-tools",
    "api-costs",
    "llm"
  ],
  "author": "Neurall",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Neurall-build/mockproxy.git"
  },
  "homepage": "https://github.com/Neurall-build/mockproxy#readme",
  "bugs": {
    "url": "https://github.com/Neurall-build/mockproxy/issues"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.0"
  },
  "private": false,
  "devDependencies": {
    "@types/bun": "latest",
    "@types/better-sqlite3": "^7.6.13"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.0",
    "chalk": "^5.6.2",
    "gpt-tokenizer": "^3.4.0",
    "hono": "^4.12.15"
  }
}
